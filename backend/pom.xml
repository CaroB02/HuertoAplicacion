<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM "agregador": solo sirve para abrir los 3 microservicios JUNTOS en IntelliJ.
  En IntelliJ: File > Open > carpeta "backend" (una sola vez). Aparecen los 3 módulos
  y cada uno se ejecuta con el play verde de su clase ...Application.
  No cambia nada de los microservicios: cada uno sigue siendo un proyecto Maven completo
  y también se puede abrir y ejecutar por separado.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cl.duoc.huerto</groupId>
    <artifactId>huerto-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>huerto-backend</name>
    <description>Agrupa los microservicios del Huerto Escolar (DSY1105)</description>

    <modules>
        <module>ms-usuarios</module>
        <module>ms-huerto</module>
        <module>ms-tareas</module>
    </modules>
</project>
